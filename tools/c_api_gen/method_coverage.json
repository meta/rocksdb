{
  "reasons": {
    "not-yet": "No C binding yet, and nothing needs designing first. Add one when it is needed.",
    "wide-columns": "Wide columns and attribute groups have no C representation yet.",
    "multiget": "Part of the batched MultiGet API, which needs a C design for pinned, zero-copy results.",
    "collections": "Takes or returns a C++ container (vector, map, set) that has no C collection type.",
    "no-handle": "Uses a C++ type that has no C handle.",
    "borrowed-object": "Returns an object the caller does not own, and the C API has no non-owning handle for that type.",
    "timestamped-snapshots": "Timestamped snapshots are shared_ptr<const Snapshot>, and the C snapshot handle has no shared ownership.",
    "ingestion-handles": "File ingestion handles carry ownership from the prepare step to the commit step, which needs a C lifetime design.",
    "lifetime": "Shares or transfers ownership in a way the C API has no convention for.",
    "callbacks": "Takes a C++ callback object or std::function.",
    "async": "Asynchronous or coroutine API with no C equivalent.",
    "cache-entries": "Low-level cache entry API (Handle, CacheItemHelper, ObjectPtr) that C has no design for.",
    "customizable": "Customizable and Configurable plumbing. The C API configures these objects through dedicated setters and option strings.",
    "cleanable": "Cleanup hooks that RocksDB registers internally.",
    "internal": "Called by RocksDB itself rather than by applications."
  },
  "excluded_bases": {
    "Customizable": "customizable",
    "Configurable": "customizable",
    "Cleanable": "cleanable"
  },
